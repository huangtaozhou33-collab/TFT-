# TFT Assistant / TFT 助手配置
# Local npm start: copy this template to .env and fill your own credentials.
# 本地 npm start：复制为 .env 后填写自己的密钥；不要提交 .env。
# Docker: run node scripts/init-docker-env.mjs and edit .env.docker instead.
# Docker 部署填写生成的 .env.docker，修改后重新创建 app 容器。
# Browsing needs no model key. AI chat requires ONE chat provider key below.
# 浏览页面无需模型密钥；助手生成回答需填写所选一家聊天模型的 API Key。
# Example: AI_PROVIDER=deepseek + DEEPSEEK_API_KEY; leave other providers blank.
# 例如选择 deepseek 并填写 DEEPSEEK_API_KEY；不必填写所有厂商密钥。
AI_API_KEY=
AI_PROVIDER=deepseek
# deepseek | qwen | openai | anthropic | kimi | compatible
# Blank URL/model uses the selected provider's preset. Custom endpoints: compatible.
AI_BASE_URL=
AI_MODEL=
# Independent provider keys for POST /api/models switching. Never shared across providers.
DEEPSEEK_API_KEY=
QWEN_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
KIMI_API_KEY=
# Examples: deepseek-flash; qwen-plus; gpt-4.1; claude-sonnet-4-6; kimi-k2.5
# Models are examples, not a promise of account access. See docs/MODEL_CONFIGURATION.md.

# Embedding is optional for chat/statistics, required for API-backed vector retrieval.
# Embedding 不是聊天/统计查询的必填项；启用向量语义检索时才需要配置。
# Set provider, key, model, endpoint and dimensions; start Milvus and explicitly
# run npm run rag:index (may incur charges). See docs/SETUP.md.
# 需配置厂商、密钥、模型、地址及匹配维度，启动 Milvus 并显式建索引（可能收费）。
# Without vectors, lexical retrieval remains available. Chat keys are not reused.
# 未配置向量检索时可使用关键词检索；聊天 Key 不会自动作为 Embedding Key。
# Embedding selection is independent of chat. Changing model requires a matching index.
EMBEDDING_PROVIDER=compatible
# openai: text-embedding-3-small (1536) or text-embedding-3-large (3072)
# qwen: text-embedding-v4 (1024); compatible: specify your own OpenAI-compatible API
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=0
EMBEDDING_API_KEY=
OPENAI_EMBEDDING_API_KEY=
QWEN_EMBEDDING_API_KEY=
# Local Milvus endpoint; Docker uses http://milvus:19530 (see setup guide).
# 本地向量库地址；Docker 的 RAG 配置请参照启动文档，不要填写 localhost。
MILVUS_URL=
# Inference budget; DeepSeek thinking ignores temperature, so it is not exposed.
AI_THINKING=enabled
AI_THINKING_BUDGET=4096
AI_REASONING_EFFORT=high
AI_MAX_TOKENS=8192
AI_MAX_TOOL_CALLS=12
AI_MAX_ROUNDS=8
AI_REQUEST_TIMEOUT_MS=120000
AI_TURN_TIMEOUT_MS=240000
# Riot development keys expire after 24 hours. Docker uses .env.docker instead.
RIOT_API_KEY=
RIOT_REGION=asia
# Optional Docker profile: --profile riot. All values are bounded by the worker.
RIOT_COLLECTION_INTERVAL_HOURS=24
RIOT_COLLECTION_MAX_MATCHES=25
RIOT_COLLECTION_SEEDS=3
PORT=3000
