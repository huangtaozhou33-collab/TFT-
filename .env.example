AI_API_KEY=
AI_PROVIDER=deepseek
# deepseek | qwen | openai | anthropic | kimi | compatible
# Blank URL/model uses the selected provider's preset. Custom endpoints: compatible.
AI_BASE_URL=
AI_MODEL=
# Independent provider keys for POST /api/models switching. Never shared across providers.
DEEPSEEK_API_KEY=
QWEN_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
KIMI_API_KEY=
# Examples: deepseek-flash; qwen-plus; gpt-4.1; claude-sonnet-4-6; kimi-k2.5
# Models are examples, not a promise of account access. See docs/MODEL_CONFIGURATION.md.

# Embedding selection is independent of chat. Changing model requires a matching index.
EMBEDDING_PROVIDER=compatible
# openai: text-embedding-3-small (1536) or text-embedding-3-large (3072)
# qwen: text-embedding-v4 (1024); compatible: specify your own OpenAI-compatible API
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=0
EMBEDDING_API_KEY=
OPENAI_EMBEDDING_API_KEY=
QWEN_EMBEDDING_API_KEY=
# Inference budget; DeepSeek thinking ignores temperature, so it is not exposed.
AI_THINKING=enabled
AI_THINKING_BUDGET=4096
AI_REASONING_EFFORT=high
AI_MAX_TOKENS=8192
AI_MAX_TOOL_CALLS=12
AI_MAX_ROUNDS=8
AI_REQUEST_TIMEOUT_MS=120000
AI_TURN_TIMEOUT_MS=240000
# Riot development keys expire after 24 hours. Docker uses .env.docker instead.
RIOT_API_KEY=
RIOT_REGION=asia
# Optional Docker profile: --profile riot. All values are bounded by the worker.
RIOT_COLLECTION_INTERVAL_HOURS=24
RIOT_COLLECTION_MAX_MATCHES=25
RIOT_COLLECTION_SEEDS=3
PORT=3000
